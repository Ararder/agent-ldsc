{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ararder/agent-ldsc/schemas/request.schema.json",
  "title": "agent-ldsc LD-score request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_id", "scientific_profile", "annotations"],
  "properties": {
    "schema_version": {"const": 1},
    "reference_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"},
    "scientific_profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"},
    "description": {"type": "string"},
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "file", "species"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "type": {"enum": ["bed", "genes"]},
          "file": {"type": "string", "minLength": 1},
          "species": {"const": "human"},
          "allow_drop": {"type": "array", "uniqueItems": true,
                         "items": {"enum": ["non_autosomal", "liftover_unmapped", "gene_unmapped"]}},
          "build": {"enum": ["GRCh37", "hg19", "GRCh38", "hg38"]},
          "id_type": {"enum": ["symbol", "ensembl_gene"]},
          "gene_model": {"const": "gene_span"},
          "flank_bp": {"type": "integer", "minimum": 0},
          "header": {"type": "boolean"}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "bed"}}},
           "then": {"required": ["build"],
                    "not": {"anyOf": [{"required": ["id_type"]}, {"required": ["flank_bp"]}, {"required": ["gene_model"]}, {"required": ["header"]}]}}},
          {"if": {"properties": {"type": {"const": "genes"}}},
           "then": {"required": ["id_type", "gene_model", "flank_bp"], "not": {"required": ["build"]}}}
        ],
        "additionalProperties": false
      }
    }
  }
}
